<?xml version="1.0" encoding="utf-8"?>
<!--
  Fonte única de pacotes: só o nuget.org, independente das fontes configuradas na máquina. Com o gerenciamento central
  de pacotes (Directory.Packages.props), mais de uma fonte sem mapeamento gera o aviso NU1507, que o -warnaserror da CI
  transformaria em erro, e deixa a origem de cada pacote ambígua.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
