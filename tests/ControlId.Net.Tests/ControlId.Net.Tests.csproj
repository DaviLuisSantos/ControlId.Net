<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 e net10.0 consomem o build net8.0 das bibliotecas (net10.0 confirma a compatibilidade com o .NET 10);
      net48 consome o build netstandard2.0, que é o caminho de quem usa .NET Framework.
    -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlId.Net\ControlId.Net.csproj" />
    <ProjectReference Include="..\..\src\ControlId.Net.DependencyInjection\ControlId.Net.DependencyInjection.csproj" />
  </ItemGroup>

  <!-- O pacote ASP.NET Core é net8.0: roda sobre o ASP.NET Core 8 e o 10, cada um com o TestHost da sua versão. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <ProjectReference Include="..\..\src\ControlId.Net.AspNetCore\ControlId.Net.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <!-- O pacote de Push com EF Core é net10.0 (o EF Core 10 exige o .NET 10): os testes dele só existem nesse alvo. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\ControlId.Net.Push.EntityFrameworkCore\ControlId.Net.Push.EntityFrameworkCore.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="EfPushStoreTests.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="AspNetCore*.cs" />
    <Reference Include="System.Net.Http" />
    <!-- Assemblies de referência do .NET Framework sem depender do targeting pack instalado. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <!--
      AddInMemoryCollection vem do Microsoft.Extensions.Configuration, que chega pelo pacote de DI
      (Options.ConfigurationExtensions -> Configuration.Binder). Uma referência direta aqui ficaria para trás nas
      atualizações do Dependabot (que não altera ItemGroups condicionais) e quebraria o restore com NU1605.
    -->

  </ItemGroup>

</Project>
