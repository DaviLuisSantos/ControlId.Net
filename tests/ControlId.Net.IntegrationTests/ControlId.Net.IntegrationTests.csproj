<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes de ponta a ponta: a biblioteca fala HTTP de verdade (Kestrel, sockets) com o simulador de equipamento, e o
    simulador chama de volta um servidor ASP.NET Core com as rotas do ControlId.Net.AspNetCore (Monitor).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="ControlId" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http.Features" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlId.Net\ControlId.Net.csproj" />
    <ProjectReference Include="..\..\src\ControlId.Net.AspNetCore\ControlId.Net.AspNetCore.csproj" />
    <ProjectReference Include="..\..\tools\ControlId.Net.Simulator\ControlId.Net.Simulator.csproj" />
  </ItemGroup>

</Project>
