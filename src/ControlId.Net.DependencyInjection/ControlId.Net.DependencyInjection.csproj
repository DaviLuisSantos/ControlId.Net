<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>ControlId.DependencyInjection</RootNamespace>

    <PackageId>ControlId.Net.DependencyInjection</PackageId>
    <Description>Registro do ControlId.Net no IServiceCollection: AddControlIdAccess e AddControlIdRep, com vários equipamentos por nome, IHttpClientFactory e appsettings.</Description>
    <PackageTags>controlid;control-id;idaccess;idflex;idface;idclass;rep;dependency-injection;ihttpclientfactory</PackageTags>
  </PropertyGroup>

  <!-- No netstandard2.0 as dependências ficam nas versões mínimas seguras (ADR 0030; valores no Directory.Packages.props). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- BackgroundService do guardião de configuração (AddControlIdConfigurationGuard). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="$(ControlIdMinHostingAbstractions)" />
    <PackageReference Include="Microsoft.Extensions.Http" VersionOverride="$(ControlIdMinHttp)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" VersionOverride="$(ControlIdMinOptionsConfigurationExtensions)" />
    <!-- AddControlIdDevices no AddHealthChecks(). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" VersionOverride="$(ControlIdMinHealthChecks)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <!-- BackgroundService do guardião de configuração (AddControlIdConfigurationGuard). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- AddControlIdDevices no AddHealthChecks(). -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlId.Net\ControlId.Net.csproj" />
  </ItemGroup>

</Project>
