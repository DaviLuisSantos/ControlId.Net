<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Configuração comum dos pacotes publicados (tudo em src/). -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- Compara a API com a última versão publicada e com os outros alvos do mesmo pacote; quebras viram erro no pack. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.5.0-alpha.1</PackageValidationBaselineVersion>

    <!--
      RS0026/RS0027: "não ter várias sobrecargas com parâmetros opcionais". A API usa esse padrão de propósito (ex.:
      GetConfigurationAsync por seção ou por várias seções, ambas com CancellationToken opcional); a compatibilidade entre
      versões já é verificada pela validação de pacote acima.
    -->
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>

    <!--
      Regras de qualidade recomendadas pela Microsoft, com estas exceções:
      - CA1510, CA1513, CA1845, CA1846, CA1847, CA1850, CA1865, CA2249: sugerem APIs que não existem no netstandard2.0
        (ThrowIfNull, ThrowIf, sobrecargas com Span, HashData, Contains/EndsWith(char)); atender exigiria #if em cada ponto.
      - CA1716, CA1720: parâmetros como "object" seguem os nomes da API do equipamento; renomear quebraria quem usa
        argumentos nomeados.
      - CA1848: LoggerMessage entra junto com a instrumentação (fase 3 do docs/PLANO.md).
    -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1510;CA1513;CA1845;CA1846;CA1847;CA1850;CA1865;CA2249;CA1716;CA1720;CA1848</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    API pública registrada em PublicAPI.Shipped.txt (o que já foi publicado) e PublicAPI.Unshipped.txt (o que entra na
    próxima versão). Mudar a API sem atualizar os arquivos é aviso no build (RS0016/RS0017).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
