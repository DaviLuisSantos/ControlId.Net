<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>ControlId</RootNamespace>

    <PackageId>ControlId.Net</PackageId>
    <Description>Cliente .NET não oficial para equipamentos Control iD: linha de acesso (iDAccess, iDFlex, iDFace) e relógios de ponto REP iDClass.</Description>
    <PackageTags>controlid;control-id;idaccess;idflex;idface;idclass;rep;afd;access-control;controle-de-acesso;ponto</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- No netstandard2.0 as dependências ficam nas versões mínimas seguras (ADR 0030; valores no Directory.Packages.props). -->
    <PackageReference Include="System.Text.Json" VersionOverride="$(ControlIdMinSystemTextJson)" />
    <!-- IAsyncEnumerable da leitura paginada. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" VersionOverride="$(ControlIdMinBclAsyncInterfaces)" />
    <!-- ActivitySource e Meter (OpenTelemetry); no net8.0 vêm do runtime. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" VersionOverride="$(ControlIdMinDiagnosticSource)" />
  </ItemGroup>

  <!-- ILogger: logs estruturados via ControlIdDeviceOptions.LoggerFactory. Traz também o gerador de LoggerMessage. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="$(ControlIdMinLoggingAbstractions)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlId.Net.Tests" />
    <InternalsVisibleTo Include="ControlId.Net.DependencyInjection" />
  </ItemGroup>

</Project>
