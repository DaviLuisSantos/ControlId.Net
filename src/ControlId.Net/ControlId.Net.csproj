<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>ControlId</RootNamespace>

    <PackageId>ControlId.Net</PackageId>
    <Description>Cliente .NET não oficial para equipamentos Control iD: linha de acesso (iDAccess, iDFlex, iDFace) e relógios de ponto REP iDClass.</Description>
    <PackageTags>controlid;control-id;idaccess;idflex;idface;idclass;rep;afd;access-control;controle-de-acesso;ponto</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
    <!-- IAsyncEnumerable da leitura paginada. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" />
    <!-- ActivitySource e Meter (OpenTelemetry); no net8.0 vêm do runtime. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- ILogger: logs estruturados via ControlIdDeviceOptions.LoggerFactory. Traz também o gerador de LoggerMessage. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlId.Net.Tests" />
    <InternalsVisibleTo Include="ControlId.Net.DependencyInjection" />
  </ItemGroup>

</Project>
